{
  "name": "Infinitech Admin",
  "short_name": "Infinitech Admin",
  "description": "Infinitech admin panel",
  "lang": "en-US",
  "id": "/admin",
  "start_url": "/admin/login",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#04111d",
